@startuml

title FinFeeds

' configuration
hide circle
skinparam linetype ortho

package "demo-core-layer" {
    [CoreLayer]
}

package "demo-service-layer" {
    [DataLayer]
}

package "demo-twelvedata-service-layer" {
    component TwelveDataAdapter {
        [TwelveDataServiceLocator]
    }


}

package "swift-twelvedata" {
    [TwelveDataStream]
    [TwelveDataREST]
}


package "swift-logging-bootstrap" {
    [LoggingBootstrap]
    [LoggingBootstrapUI]
}

package "swift-io-stream" {
    [StreamWebSocket]
}



package "App" {
    component FinFeeds {
        [Presentation Layer]
        component AppData {

            database "SwiftData" {
                
            }

            interface "Data Adapters" as DataAdapters

            [SwiftData] <-up- DataAdapters

            [ServiceLocator]

            DataAdapters -> [ServiceLocator]
        }
    }
}

[DataLayer] ..> [CoreLayer]

[TwelveDataAdapter] <|.. [DataLayer]

[TwelveDataStream] *--> [StreamWebSocket]
[TwelveDataAdapter] *--> [TwelveDataStream]
[TwelveDataAdapter] *--> [TwelveDataREST]


[TwelveDataServiceLocator] ..> [ServiceLocator]

[ServiceLocator] *--> [DataLayer]


[Presentation Layer] ..> [ServiceLocator] : use

[Presentation Layer] *--> [LoggingBootstrapUI]
[FinFeeds] *--> [LoggingBootstrap]

[AppData] *--> [CoreLayer]


[Presentation Layer] --> DataAdapters

@enduml